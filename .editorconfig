# 本项目编码基线（对应 AGENTS.md / README 中的习惯）：UTF-8、Unix 换行、去行尾空白、文件末尾保留换行
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,sh}]
indent_style = space
indent_size = 4

[*.{xml,yml,yaml,sql,properties}]
indent_style = space
indent_size = 2

[*.{md,ini,conf}]
indent_style = space
indent_size = 2
