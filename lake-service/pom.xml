<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.demo.lake</groupId>
    <artifactId>lakehouse-demo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>lake-service</artifactId>
  <name>lake-service</name>
  <description>Spring Boot 服务层：WebFlux 查询接口（含 SSE 流）+ Spark 批作业编排（JDK 21 / Boot 4 / logback）</description>

  <properties>
    <!-- 本模块是唯一要求 JDK 21 的模块；其余模块仍是 release 11（Spark 3.5.1 官方只支持到 17） -->
    <maven.compiler.release>21</maven.compiler.release>
    <java.version>21</java.version>
    <!-- Boot 4.x 的 logback 1.5.x 要求 slf4j 2.0.2x；父 pom 为 Spark 锁的是 2.0.7，这里按模块覆盖 -->
    <slf4j.version>2.0.20</slf4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.demo.lake</groupId>
      <artifactId>platform-common</artifactId>
    </dependency>

    <!-- 编译期生成 @Slf4j 的 logger 与访问器；provided 不进 fat jar -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
    </dependency>

    <!-- Web 层：WebFlux + Reactor Netty。Boot 4 把 starter-web 拆成了 webmvc / webflux 两个 starter，
         这里用 webflux：事件循环 + 背压，长连接（SSE）比 Servlet 那套自然 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <!-- 健康检查 / 指标；Prometheus registry 让 Micrometer 指标可被直接抓取 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- 接口文档：/v3/api-docs（OpenAPI JSON）+ /swagger-ui.html（可在线调试） -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
    </dependency>

    <!-- 连接池 + Trino 驱动：即席查询并发复用连接，比 CLI 的「一次一连接」更接近生产形态 -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <!-- spring-jdbc：状态库 / 审计保险箱 / 配额的数据库访问改用 JdbcTemplate，
         这种「手写 SQL + 自定义映射」场景要 JdbcTemplate 是足够轻，引入 JPA 反而过重 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.trino</groupId>
      <artifactId>trino-jdbc</artifactId>
    </dependency>
    <!-- 运行状态库：复用 infra 里的 Postgres，让服务无状态、多实例可共享运行态 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.11</version>
      <!-- 配额的 LISTEN 连接要直接引用 PGConnection/PGNotification，故用 compile 而非 runtime -->
    </dependency>
    <!-- H2 只在测试里当 Postgres 的轻量替身，验 RunStateStore 的 SQL 行为 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.4.240</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- JDK 11 下直接 mvn package 会报 "release version 21 not supported"，
           这里提前给出能看懂的提示（只影响本模块，spark-batch 单独构建仍可用 JDK 11） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>require-jdk-21</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>lake-service 需要 JDK 21：用 bin/build.sh 构建，或 export JAVA21_HOME 后 mvn -pl lake-service</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 打成可执行 fat jar：java -jar lake-service/target/lake-service-1.0.0-SNAPSHOT.jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <configuration>
          <!-- repackage 默认把 provided 依赖也打包进来；lombok 只在编译期有用，
               进了 BOOT-INF/lib 只会白占体积（需要在运行时排除它的 classpath 扫描） -->
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
