<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.demo.lake</groupId>
  <artifactId>lakehouse-demo</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>lakehouse-demo</name>
  <description>Spark(批处理) + Iceberg(存储/表格式) + Trino(即席查询) 湖仓一体脚手架</description>

  <modules>
    <module>platform-common</module>
    <module>spark-batch</module>
    <module>lake-adhoc</module>
    <module>lake-service</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Spark 4.1 要求 Java 17+，批处理模块产出 Java 17 字节码；lake-service 在模块内覆盖成 21 -->
    <maven.compiler.release>17</maven.compiler.release>
    <java.version>17</java.version>

    <!-- 版本矩阵：Spark 4.1.x(Java17/Scala2.13) + Iceberg 1.11.x + Trino 476(JDBC) -->
    <spark.version>4.3.0</spark.version>
    <scala.binary.version>2.13</scala.binary.version>
    <iceberg.version>1.12.0</iceberg.version>
    <hadoop.version>3.5.0</hadoop.version>
    <!-- 对齐 Spark 4.1 发行版自带的 Hive（spark-parent 2.13 的 hive.version=2.3.10） -->
    <hive.version>2.3.10</hive.version>
    <trino.version>476</trino.version>
    <!-- 注解处理：编译期生成访问器 / 构造器 / logger，scope=provided 不进产物 -->
    <lombok.version>1.18.48</lombok.version>
    <!-- 与 Spark 4.1.4 自带版本对齐（spark-parent 的 log4j.version=2.24.3 / slf4j.version=2.0.17），
         版本错配会在启动 SparkSession 时报 ServiceLoaderUtil.loadServices NoSuchMethodError -->
    <log4j.version>2.26.1</log4j.version>
    <slf4j.version>2.0.20</slf4j.version>
    <junit.version>5.10.2</junit.version>

    <!--
      lake-service 使用 JDK 21 + Spring Boot 4（Spring Framework 7 / Reactor Netty / Jakarta EE 11），
      在模块内把 release 覆盖成 21；本文件保持 11 以适配 Spark 集群。
    -->
    <spring.boot.version>4.2.0</spring.boot.version>
    <!-- 与 Boot 4.2.0 自带的 micrometer-core 对齐（见 mvn dependency:tree），Prometheus registry 不要另起版本 -->
    <micrometer.version>1.18.0</micrometer.version>
    <!-- springdoc 3.x 对应 Boot 4（2.x 只支持 Boot 3）；3.1.1 基于 Boot 4.1.0，实测与 4.2.0 兼容 -->
    <springdoc.version>3.2.1</springdoc.version>
    <hikaricp.version>7.1.0</hikaricp.version>

    <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.6.1</maven.surefire.plugin.version>
    <exec.plugin.version>3.7.0</exec.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- ========== 内部模块 ========== -->
      <dependency>
        <groupId>com.demo.lake</groupId>
        <artifactId>platform-common</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- ========== Lombok ========== -->
      <!--
        纯编译期依赖：provided 保证它不进 spark-batch 的运行 classpath；
        Spring Boot 的 repackage 会把 provided 也打进 fat jar，所以 lake-service 里另外 exclude。
      -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- ========== Spark ========== -->
      <dependency>
        <groupId>org.apache.spark</groupId>
        <artifactId>spark-sql_${scala.binary.version}</artifactId>
        <version>${spark.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.spark</groupId>
        <artifactId>spark-core_${scala.binary.version}</artifactId>
        <version>${spark.version}</version>
      </dependency>

      <!-- ========== Iceberg ========== -->
      <!-- runtime 包已 relocate 掉 Iceberg 内部依赖，避免与 Spark 的 guava/jackson 冲突 -->
      <dependency>
        <groupId>org.apache.iceberg</groupId>
        <artifactId>iceberg-spark-runtime-4.1_${scala.binary.version}</artifactId>
        <version>${iceberg.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.iceberg</groupId>
        <artifactId>iceberg-aws-bundle</artifactId>
        <version>${iceberg.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.hadoop</groupId>
        <artifactId>hadoop-aws</artifactId>
        <version>${hadoop.version}</version>
      </dependency>

      <!-- ========== Hive Metastore 客户端（仅本地 exec:java 需要） ========== -->
      <!--
        Spark 的 Maven 构件（spark-sql）只带 hive-storage-api，hive-metastore / hive-common
        这些 jar 只在发行版 $SPARK_HOME/jars 里。Iceberg 的 HiveCatalog 会链接
        org.apache.hadoop.hive.metastore.api.* 和 HiveConf，本地没有就会
        NoClassDefFoundError: UnknownDBException。上集群由 Spark 自带，所以 scope=provided。
      -->
      <dependency>
        <groupId>org.apache.hive</groupId>
        <artifactId>hive-metastore</artifactId>
        <version>${hive.version}</version>
        <exclusions>
          <!-- hadoop 2.x 时代的 system-scope 依赖，JDK 9+ 没有 tools.jar，
               不排除会让整个依赖图解析失败 -->
          <exclusion>
            <groupId>jdk.tools</groupId>
            <artifactId>jdk.tools</artifactId>
          </exclusion>
          <!-- hive-common 2.3.9 会带进 SLF4J 1.7 的旧绑定（log4j-slf4j-impl 2.6.2 /
               slf4j-log4j12），和本项目的 log4j-slf4j2-impl 2.20 抢 StaticLoggerBinder，
               表现为 NoSuchMethodError: Log4jLoggerFactory.<init>(Log4jMarkerFactory) -->
          <exclusion>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
          </exclusion>
          <exclusion>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-web</artifactId>
          </exclusion>
          <exclusion>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-log4j12</artifactId>
          </exclusion>
          <exclusion>
            <groupId>log4j</groupId>
            <artifactId>log4j</artifactId>
          </exclusion>
        </exclusions>
      </dependency>

      <!-- ========== Trino (JDBC 客户端) ========== -->
      <!-- trino-jdbc 476 是 Java 11 字节码，可在本 reactor 的 release 17 运行时上直接使用 -->
      <dependency>
        <groupId>io.trino</groupId>
        <artifactId>trino-jdbc</artifactId>
        <version>${trino.version}</version>
      </dependency>

      <!-- ========== Spring Boot（仅 lake-service） ========== -->
      <!-- 不导入 spring-boot-dependencies BOM：它会改掉本项目为 Spark 锁定的 slf4j/log4j/junit 版本。
           starter 的 pom 是 flatten 过的，依赖版本自带，显式写版本即可。 -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-webflux</artifactId>
        <version>${spring.boot.version}</version>
      </dependency>
      <!-- lake-service 的状态库/审计/配额等数据访问改用 JdbcTemplate；Boot 4.2 已带，这里做版本管理 -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-jdbc</artifactId>
        <version>${spring.boot.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-actuator</artifactId>
        <version>${spring.boot.version}</version>
      </dependency>
      <!-- Prometheus registry：接上 Micrometer 后 /actuator/prometheus 才输出可被抓取的文本 -->
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-registry-prometheus</artifactId>
        <version>${micrometer.version}</version>
      </dependency>
      <!-- OpenAPI / Swagger UI：WebFlux 版 starter（含 UI），只给 lake-service 用 -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.zaxxer</groupId>
        <artifactId>HikariCP</artifactId>
        <version>${hikaricp.version}</version>
      </dependency>

      <!-- ========== 日志 ========== -->
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-core</artifactId>
        <version>${log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-slf4j2-impl</artifactId>
        <version>${log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>

      <!-- ========== 测试 ========== -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <compilerArgs>
              <arg>-parameters</arg>
            </compilerArgs>
            <!--
              显式声明处理器路径：不依赖 classpath 上的隐式扫描，构建更可预期；
              处理器在编译结束后自动失效，运行时不需要 lombok jar。
            -->
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
          <configuration>
            <!-- Spark 在 JDK11+ 需要反射打开这些包 -->
            <argLine>
              --add-opens=java.base/java.lang=ALL-UNNAMED
              --add-opens=java.base/java.lang.invoke=ALL-UNNAMED
              --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
              --add-opens=java.base/java.io=ALL-UNNAMED
              --add-opens=java.base/java.net=ALL-UNNAMED
              --add-opens=java.base/java.nio=ALL-UNNAMED
              --add-opens=java.base/java.util=ALL-UNNAMED
              --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
              --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED
              --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
              --add-opens=java.base/sun.nio.cs=ALL-UNNAMED
              --add-opens=java.base/sun.security.action=ALL-UNNAMED
              --add-opens=java.base/sun.util.calendar=ALL-UNNAMED
            </argLine>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec.plugin.version}</version>
          <configuration>
            <!-- 父模块/公共模块不该被执行；需要跑的模块显式 skip=false -->
            <skip>true</skip>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!--
    s3 相关的两个依赖（iceberg-aws-bundle / hadoop-aws）声明在 spark-batch/pom.xml 的 <profile>s3</profile> 里，
    只有批处理模块需要它们，父 pom 不再重复声明（否则每个子模块都会被塞进 268MB 的 aws-java-sdk-bundle）。
  -->
</project>
